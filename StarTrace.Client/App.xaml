<Application
    x:Class="StarTrace.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="InkColor">#FF25263D</Color>
            <Color x:Key="PurpleColor">#FF7867E5</Color>
            <Color x:Key="SurfaceColor">#FFFCFCFF</Color>
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
            <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
