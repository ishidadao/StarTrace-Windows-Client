<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="星迹 StarTrace"
      Manufacturer="StarTrace Contributors"
      Version="$(InstallerVersion)"
      Language="2052"
      UpgradeCode="2F561846-66C6-49A5-99AD-20F7D54135C0"
      Scope="perMachine"
      InstallerVersion="500"
      Compressed="yes">

    <SummaryInformation Description="星迹原神 / 鸣潮抽卡记录客户端" Manufacturer="StarTrace Contributors" />
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的星迹客户端。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="INSTALLLEVEL" Value="1" />
    <WixVariable Id="WixUILicenseRtf" Value="$(SourceRoot)\LICENSE.rtf" />
    <ui:WixUI Id="WixUI_FeatureTree" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="StarTrace" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StarTraceStartMenuFolder" Name="星迹 StarTrace" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Icon Id="StarTraceIcon.ico" SourceFile="$(SourceRoot)\StarTrace.Client\Assets\StarTrace.ico" />

    <Feature Id="MainFeature" Title="星迹客户端（必需）" Description="星迹主程序与 Windows App SDK 自包含运行库" Level="1" AllowAbsent="no" Display="expand">
      <ComponentGroupRef Id="ApplicationFiles" />

      <Feature Id="StartupFeature" Title="开机自启动" Description="登录 Windows 后自动运行星迹" Level="2" AllowAbsent="yes">
        <ComponentRef Id="StartupComponent" />
      </Feature>
      <Feature Id="DesktopShortcutFeature" Title="桌面快捷方式" Description="在桌面添加星迹快捷方式" Level="1" AllowAbsent="yes">
        <ComponentRef Id="DesktopShortcutComponent" />
      </Feature>
      <Feature Id="StartMenuShortcutFeature" Title="开始菜单快捷方式" Description="在开始菜单添加星迹快捷方式" Level="1" AllowAbsent="yes">
        <ComponentRef Id="StartMenuShortcutComponent" />
      </Feature>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**">
        <Exclude Files="$(PublishDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartupComponent" Directory="INSTALLFOLDER" Guid="D334B9A5-71E7-47B1-A9EB-91BC836028C5">
      <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="StarTrace" Type="string" Value="&quot;[INSTALLFOLDER]StarTrace.Client.exe&quot;" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="DD3033A1-C13B-46E3-B6C2-C1C7C3627B1F">
      <Shortcut Id="DesktopShortcut" Name="星迹 StarTrace" Description="原神 / 鸣潮抽卡记录助手" Target="[INSTALLFOLDER]StarTrace.Client.exe" WorkingDirectory="INSTALLFOLDER" Icon="StarTraceIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\StarTrace" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcutComponent" Directory="StarTraceStartMenuFolder" Guid="A65983E9-D6C3-4E0E-A9A4-4F218334D072">
      <Shortcut Id="StartMenuShortcut" Name="星迹 StarTrace" Description="原神 / 鸣潮抽卡记录助手" Target="[INSTALLFOLDER]StarTrace.Client.exe" WorkingDirectory="INSTALLFOLDER" Icon="StarTraceIcon.ico" />
      <RemoveFolder Id="RemoveStartMenuFolder" Directory="StarTraceStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\StarTrace" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
